{{range .Types}}
    {{$typeName := .TypeName -}}
    {{$discriminator := .Schema.Discriminator}}
    {{$schema := .Schema -}}
    {{range .Schema.UnionElements}}
        {{$stamp := $schema.DiscriminatorStampFor . -}}
        // As{{ .Method }} returns the union data inside the {{$typeName}} as a {{.}}
        func (t {{$typeName}}) As{{ .Method }}() ({{.}}, error) {
            var body {{.}}
            if len(t.union) > 0 {
                err := json.Unmarshal(t.union, &body)
                if err != nil {
                    return body, err
                }
            }
            if len(t.xunion) > 0 {
                err := xml.Unmarshal(t.xunion, &body)
                if err != nil {
                    return body, err
                }
            }
            return body, nil
        }

        // From{{ .Method }} overwrites any union data inside the {{$typeName}} as the provided {{.}}
        func (t *{{$typeName}}) From{{ .Method }} (v {{.}}) error {
            {{if and $stamp $stamp.Property -}}
                {{if $stamp.Property.IsPointer -}}
                    var discriminator {{$stamp.Property.Schema.TypeDecl}} = "{{$stamp.Value}}"
                    t.{{$stamp.Property.GoFieldName}} = &discriminator
                {{else -}}
                    t.{{$stamp.Property.GoFieldName}} = "{{$stamp.Value}}"
                {{end -}}
            {{end -}}
            b, err := json.Marshal(v)
            if err != nil {
                return err
            }
            {{if $stamp -}}
                b, err = runtime.JSONMerge(b, []byte(`{{$stamp.JSONPatch}}`))
                if err != nil {
                    return err
                }
            {{end -}}
            t.union = b
            {{if and $stamp $stamp.VariantProperty -}}
                // The JSON stamp above never reaches v, so set the variant's own
                // discriminator field for the XML copy.
                {{if $stamp.VariantProperty.IsPointer -}}
                    setXMLDiscriminator(&v.{{$stamp.VariantProperty.GoFieldName}}, "{{$stamp.Value}}")
                {{else -}}
                    v.{{$stamp.VariantProperty.GoFieldName}} = "{{$stamp.Value}}"
                {{end -}}
            {{end -}}
            b, err = xml.Marshal(v)
            if err != nil {
                return err
            }
            t.xunion = b

            return nil
        }

        // Merge{{ .Method }} performs a merge with any union data inside the {{$typeName}}, using the provided {{.}}
        func (t *{{$typeName}}) Merge{{ .Method }} (v {{.}}) error {
            {{if and $stamp $stamp.Property -}}
                {{if $stamp.Property.IsPointer -}}
                    var discriminator {{$stamp.Property.Schema.TypeDecl}} = "{{$stamp.Value}}"
                    t.{{$stamp.Property.GoFieldName}} = &discriminator
                {{else -}}
                    t.{{$stamp.Property.GoFieldName}} = "{{$stamp.Value}}"
                {{end -}}
            {{end -}}
            b, err := json.Marshal(v)
            if err != nil {
              return err
            }
            {{if $stamp -}}
                b, err = runtime.JSONMerge(b, []byte(`{{$stamp.JSONPatch}}`))
                if err != nil {
                    return err
                }
            {{end}}
            merged, err := runtime.JSONMerge(t.union, b)
            t.union = merged

            // For XML, re-marshal the merged result
            {{if and $stamp $stamp.VariantProperty -}}
                {{if $stamp.VariantProperty.IsPointer -}}
                    setXMLDiscriminator(&v.{{$stamp.VariantProperty.GoFieldName}}, "{{$stamp.Value}}")
                {{else -}}
                    v.{{$stamp.VariantProperty.GoFieldName}} = "{{$stamp.Value}}"
                {{end -}}
            {{end -}}
            bx, errx := xml.Marshal(v)
            if errx != nil {
                return errx
            }
            t.xunion = bx

            return err
        }
    {{end}}

    {{if $discriminator}}
        func (t {{.TypeName}}) Discriminator() (string, error) {
            var discriminator struct {
                Discriminator string {{$discriminator.CombinedTag}}
            }
            if len(t.union) > 0 {
                err := json.Unmarshal(t.union, &discriminator)
                if err != nil {
                    return "", err
                }
                return discriminator.Discriminator, nil
            }
            if len(t.xunion) > 0 {
                err := xml.Unmarshal(t.xunion, &discriminator)
                if err != nil {
                    return "", err
                }
                return discriminator.Discriminator, nil
            }
            return "", nil
        }

        {{$cases := $schema.DiscriminatorCases -}}
        {{if $cases}}
            func (t {{.TypeName}}) ValueByDiscriminator() (interface{}, error) {
                discriminator, err := t.Discriminator()
                if err != nil {
                    return nil, err
                }
                switch discriminator{
                    {{range $cases -}}
                        case "{{.Value}}":
                            return t.As{{.Method}}()
                    {{end -}}
                    default:
                        return nil, errors.New("unknown discriminator value: "+discriminator)
                }
            }
        {{end}}
    {{end}}

    {{if not .Schema.HasAdditionalProperties}}

    func (t {{.TypeName}}) MarshalJSON() ([]byte, error) {
        b, err := t.union.MarshalJSON()
        {{if ne 0 (len .Schema.Properties) -}}
            if err != nil {
                return nil, err
            }
            object := make(map[string]json.RawMessage)
            if t.union != nil {
              err = json.Unmarshal(b, &object)
              if err != nil {
                return nil, err
              }
            }
            {{range .Schema.Properties}}
            {{if .RequiresNilCheck}}if t.{{.GoFieldName}} != nil { {{end}}
                object["{{.JsonFieldName}}"], err = json.Marshal(t.{{.GoFieldName}})
                if err != nil {
                    return nil, fmt.Errorf("error marshaling '{{.JsonFieldName}}': %w", err)
                }
            {{if .RequiresNilCheck}} }{{end}}
            {{end -}}
            b, err = json.Marshal(object)
        {{end -}}
        return b, err
    }

    func (t *{{.TypeName}}) UnmarshalJSON(b []byte) error {
        err := t.union.UnmarshalJSON(b)
        {{if ne 0 (len .Schema.Properties) -}}
            if err != nil {
                return err
            }
            object := make(map[string]json.RawMessage)
            err = json.Unmarshal(b, &object)
            if err != nil {
                return err
            }
            {{range .Schema.Properties}}
                if raw, found := object["{{.JsonFieldName}}"]; found {
                    err = json.Unmarshal(raw, &t.{{.GoFieldName}})
                    if err != nil {
                        return fmt.Errorf("error reading '{{.JsonFieldName}}': %w", err)
                    }
                }
            {{end}}
        {{end -}}
        return err
    }

    func (t {{$typeName}}) MarshalXML(e *xml.Encoder, start xml.StartElement) error {
        {{if ne 0 (len .Schema.Properties) -}}
            // Marshal with fixed properties merged into the union content
            if err := e.EncodeToken(start); err != nil {
                return err
            }

            // Write union inner content first
            if len(t.xunion) > 0 {
                d := xml.NewDecoder(bytes.NewReader([]byte(t.xunion)))
                // Skip the original start element
                if _, err := d.Token(); err != nil {
                    return err
                }
                depth := 1
                for depth > 0 {
                    tok, err := d.Token()
                    if err != nil {
                        return err
                    }
                    switch tok.(type) {
                    case xml.StartElement:
                        depth++
                    case xml.EndElement:
                        depth--
                    }
                    if depth > 0 {
                        if err := e.EncodeToken(xml.CopyToken(tok)); err != nil {
                            return err
                        }
                    }
                }
            }

            // Write fixed properties (ensures they are present even if not in xunion)
            {{range .Schema.Properties}}
            {{if .HasOptionalPointer}}if t.{{.GoFieldName}} != nil { {{end}}
            if err := e.EncodeElement(t.{{.GoFieldName}}, xml.StartElement{Name: xml.Name{Local: "{{xmlFieldName .}}"}}); err != nil {
                return fmt.Errorf("error marshaling '{{xmlFieldName .}}': %w", err)
            }
            {{if .HasOptionalPointer}} }{{end}}
            {{end -}}

            return e.EncodeToken(start.End())
        {{else -}}
            if len(t.xunion) > 0 {
                return t.xunion.MarshalXML(e, start)
            }
            if err := e.EncodeToken(start); err != nil {
                return err
            }
            return e.EncodeToken(start.End())
        {{end -}}
    }

    func (t *{{$typeName}}) UnmarshalXML(d *xml.Decoder, start xml.StartElement) error {
        var err error

        t.xunion, err = CaptureXMLElement(d, start)
        if err != nil {
            return err
        }

        {{if ne 0 (len .Schema.Properties) -}}
            // Extract fixed properties from the captured XML
            type xmlProps struct {
                {{range .Schema.Properties -}}
                {{.GoFieldName}} {{.GoTypeDef}} `xml:"{{xmlFieldName .}}"`
                {{end -}}
            }
            var props xmlProps
            if err := xml.Unmarshal(t.xunion, &props); err != nil {
                return err
            }
            {{range .Schema.Properties -}}
            t.{{.GoFieldName}} = props.{{.GoFieldName}}
            {{end -}}
        {{end -}}

        return nil
    }
    {{end}}
{{end}}
