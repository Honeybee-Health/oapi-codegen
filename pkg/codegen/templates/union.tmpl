    func (t {{$typeName}}) MarshalXML(e *xml.Encoder, start xml.StartElement) error {
        {{if ne 0 (len .Schema.Properties) -}}
            // Marshal with fixed properties merged into the union content
            if err := e.EncodeToken(start); err != nil {
                return err
            }

            // Write union inner content first
            if len(t.xunion) > 0 {
                d := xml.NewDecoder(bytes.NewReader([]byte(t.xunion)))
                // Skip the original start element
                if _, err := d.Token(); err != nil {
                    return err
                }
                depth := 1
                for depth > 0 {
                    tok, err := d.Token()
                    if err != nil {
                        return err
                    }
                    switch tok.(type) {
                    case xml.StartElement:
                        depth++
                    case xml.EndElement:
                        depth--
                    }
                    if depth > 0 {
                        if err := e.EncodeToken(xml.CopyToken(tok)); err != nil {
                            return err
                        }
                    }
                }
            }

            // Write fixed properties (ensures they are present even if not in xunion)
            {{range .Schema.Properties}}
            {{if .HasOptionalPointer}}if t.{{.GoFieldName}} != nil { {{end}}
            if err := e.EncodeElement(t.{{.GoFieldName}}, xml.StartElement{Name: xml.Name{Local: "{{xmlFieldName .}}"}}); err != nil {
                return fmt.Errorf("error marshaling '{{xmlFieldName .}}': %w", err)
            }
            {{if .HasOptionalPointer}} }{{end}}
            {{end -}}

            return e.EncodeToken(start.End())
        {{else -}}
            if len(t.xunion) > 0 {
                return t.xunion.MarshalXML(e, start)
            }
            if err := e.EncodeToken(start); err != nil {
                return err
            }
            return e.EncodeToken(start.End())
        {{end -}}
    }

    func (t *{{$typeName}}) UnmarshalXML(d *xml.Decoder, start xml.StartElement) error {
        var err error

        t.xunion, err = CaptureXMLElement(d, start)
        if err != nil {
            return err
        }

        {{if ne 0 (len .Schema.Properties) -}}
            // Extract fixed properties from the captured XML
            type xmlProps struct {
                {{range .Schema.Properties -}}
                {{.GoFieldName}} {{.GoTypeDef}} `xml:"{{xmlFieldName .}}"`
                {{end -}}
            }
            var props xmlProps
            if err := xml.Unmarshal(t.xunion, &props); err != nil {
                return err
            }
            {{range .Schema.Properties -}}
            t.{{.GoFieldName}} = props.{{.GoFieldName}}
            {{end -}}
        {{end -}}

        return nil
    }
    {{end}}
