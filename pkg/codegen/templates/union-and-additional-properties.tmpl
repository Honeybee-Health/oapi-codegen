            // Handle string values directly
            if err := a.{{.GoFieldName}}.UnmarshalText([]byte(v)); err != nil {
                return fmt.Errorf("error reading '{{.XmlProps.Name}}': %w", err)
            }
        default:
            // For other types, try direct assignment
            a.{{.GoFieldName}} = val.({{.TypeDecl}})
        }
        delete(tempMap, "{{.XmlProps.Name}}")
    }
{{end}}

    // Handle additional properties
    if len(tempMap) != 0 {
        a.AdditionalProperties = make(map[string]{{$addType}})
        for fieldName, fieldVal := range tempMap {
            // Direct assignment for XML values
            switch v := fieldVal.(type) {
            case string:
